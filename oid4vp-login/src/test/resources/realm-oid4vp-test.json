{
  "realm": "oid4vp-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifiableCredentialsEnabled": true,
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "oid4vp-card-issuer",
        "providerId": "java-keystore",
        "config": {
          "active": ["true"],
          "enabled": ["true"],
          "priority": ["0"],
          "algorithm": ["ES256"],
          "keystore": ["/opt/keycloak/data/oid4vp-test/card-issuer.p12"],
          "keystoreType": ["PKCS12"],
          "keystorePassword": ["changeit"],
          "keyAlias": ["card-issuer"],
          "keyPassword": ["changeit"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "test-app",
      "attributes": {
        "oid4vci.enabled": "true"
      },
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "@@CLIENT_SECRET@@",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "oid4vp-verified-claims",
          "protocol": "openid-connect",
          "protocolMapper": "oid4vp-verified-claims-mapper",
          "consentRequired": false,
          "config": {
            "trustFramework": "eidas",
            "trustFrameworkByVct": "urn:eudi:pid:1=eidas,urn:pn:account-holder:1=pn_account_possession",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "oid4vp",
      "providerId": "oid4vp",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "trustAnchorsPem": "@@TRUST_ANCHORS_PEM@@",
        "ownIssuerAnchorsPem": "@@OWN_ISSUER_ANCHORS_PEM@@",
        "signingKeyPem": "@@SIGNING_KEY_PEM@@",
        "signingCertPem": "@@SIGNING_CERT_PEM@@",
        "dcqlQueryJson": "@@DCQL_QUERY_JSON@@",
        "matchingClaim": "email",
        "subjectClaim": "sub",
        "subjectPolicy": "REJECT",
        "ttlSeconds": "120",
        "ownVct": "@@OWN_VCT@@",
        "ownCredentialConfigId": "@@OWN_CREDENTIAL_CONFIG_ID@@",
        "reissueBeforeSeconds": "2592000",
        "subjectClaimByVct": "urn:eudi:pid:1=sub,urn:pn:account-holder:1=sub"
      }
    }
  ]
}
